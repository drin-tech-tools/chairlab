# Copy to .env.local. Names only — never commit real values.

# Public site URL (used for share links)
NEXT_PUBLIC_SITE_URL=

# Saved builds (/api/configs, /b/[id]). Server-only: never prefix with NEXT_PUBLIC_, never import from client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local dev / tests without Supabase: use the in-memory store (refused on Vercel production).
# CONFIG_STORE=memory
